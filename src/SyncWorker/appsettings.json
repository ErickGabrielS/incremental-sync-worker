{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Sync": "Data Source=sync.db"
  },
  "Erp": {
    "BaseUrl": "http://localhost:5080/"
  },
  "Sync": {
    "IntervalSeconds": 30,
    "PageSize": 50,
    "OverlapMinutes": 5,
    "MaxReprocessAttempts": 5,
    "ReprocessBatchSize": 20
  }
}
